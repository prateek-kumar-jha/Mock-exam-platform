# Backend Environment Variables (example)
# Copy this to .env and fill in real values - never commit secrets

# Database connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=exam_platform
DB_USER=exam_user
DB_PASSWORD=exam_pass

# Redis (if used)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT secrets (must be kept secret!)
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# Bcrypt salt rounds
BCRYPT_SALT=10

# Browser origins allowed to call this API (comma-separated)
CORS_ORIGINS=http://localhost:3001

# Rate limiting on auth routes
# Rolling window all limits are counted within
RATE_LIMIT_WINDOW_MS=900000
# Max auth requests per window from one IP
RATE_LIMIT_IP_MAX=20
# Max auth requests per window against one account identifier
RATE_LIMIT_ACCOUNT_MAX=5
# Authenticated in-app traffic (auto-save fires constantly during a test)
RATE_LIMIT_SESSION_MAX=600
# Exponential backoff: first block, ceiling, and how long before a
# violation record decays back to zero (no hard lockout)
RATE_LIMIT_BLOCK_BASE_MS=60000
RATE_LIMIT_BLOCK_MAX_MS=3600000
RATE_LIMIT_BLOCK_DECAY_MS=3600000
# Redis connection resilience (fail fast rather than retry forever)
REDIS_MAX_RETRIES_PER_REQUEST=3
REDIS_MAX_RECONNECT_ATTEMPTS=10
